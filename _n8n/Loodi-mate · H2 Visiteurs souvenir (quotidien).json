    {
      "parameters": {
        "jsCode": "// n8n · nœud Code \"Calcul H2\" (mode : Run Once for All Items)\n// Entrées lues par nom de nœud : \"Événements\", \"Joueurs\", \"Parties\"\n// Sortie : une ligne par personne × partie pour la table \"Visiteurs souvenir\"\n\nconst H48 = 48 * 3600 * 1000;\n// Le nœud Airtable peut renvoyer les champs à plat ou sous .fields selon la version\nconst get = (it) => it.json.fields ?? it.json;\n\n// Personnes onboardées = ID appareil connus\nconst appareils = new Set(\n  $('Joueurs').all().map((i) => get(i)['ID appareil']).filter(Boolean)\n);\n\n// Plafond invités : N = nombre de participations de la partie\nconst nbParticipants = {};\nfor (const i of $('Parties').all()) {\n  nbParticipants[i.json.id] = (get(i)['Participations'] || []).length;\n}\n\nconst evenements = $('Événements').all()\n  .map(get)\n  .filter((e) => e['Partie']?.length && e['Date'])\n  .map((e) => ({\n    action: e['Action'],\n    origine: e['Origine'],\n    visiteur: e['ID visiteur'],\n    partie: e['Partie'][0],\n    t: new Date(e['Date']).getTime(),\n  }));\n\n// Envois du lien par partie\nconst partages = {};\nfor (const e of evenements) {\n  if (e.action === 'lien_partage') (partages[e.partie] ??= []).push(e.t);\n}\n\n// Ouvertures regroupées par personne × partie\nconst groupes = {};\nfor (const e of evenements) {\n  if (e.action !== 'souvenir_ouvert' || !e.visiteur) continue;\n  (groupes[`${e.visiteur}|${e.partie}`] ??= []).push(e);\n}\n\nconst lignes = Object.entries(groupes).map(([cle, evs]) => {\n  evs.sort((a, b) => a.t - b.t);\n  const premiere = evs[0].t;\n  const { visiteur, partie } = evs[0];\n  const tardives = evs.filter((e) => e.t - premiere > H48);\n\n  // Retour volontaire : depuis l'app, ou via le lien sans renvoi entre la 1re ouverture et celle-ci\n  const sansRenvoi = tardives.some(\n    (e) =>\n      e.origine === 'app' ||\n      !(partages[partie] || []).some((p) => p > premiere && p <= e.t)\n  );\n\n  return {\n    cle,\n    visiteur,\n    partie,\n    premiere,\n    nb: evs.length,\n    type: appareils.has(visiteur) ? 'onboardé' : 'invité',\n    rouvre: tardives.length > 0,\n    sansRenvoi,\n  };\n});\n\n// Plafond : les N premiers invités de chaque partie, par date de 1re ouverture\nconst invitesParPartie = {};\nfor (const l of lignes) {\n  if (l.type === 'invité') (invitesParPartie[l.partie] ??= []).push(l);\n}\nconst dansPlafond = new Set();\nfor (const [partie, ls] of Object.entries(invitesParPartie)) {\n  ls.sort((a, b) => a.premiere - b.premiere)\n    .slice(0, nbParticipants[partie] ?? 0)\n    .forEach((l) => dansPlafond.add(l.cle));\n}\n\nreturn lignes.map((l) => ({\n  json: {\n    'Clé': l.cle,\n    'ID visiteur': l.visiteur,\n    'Partie': [l.partie],\n    'Type': l.type,\n    'Première ouverture': new Date(l.premiere).toISOString(),\n    'Nb ouvertures': l.nb,\n    'H2 · Rouvre sans renvoi': l.sansRenvoi ? 100 : 0,\n    'H2 · Rouvre (tout)': l.rouvre ? 100 : 0,\n    'Filtre · Dans le plafond':\n      l.type === 'onboardé' || dansPlafond.has(l.cle) ? 1 : 0,\n  },\n}));\n"
      },
